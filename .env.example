# Meeting defaults shown in the form and used as a fallback when a field is blank.
# API keys are not read from here: add them in the app (Configurações), where they are stored encrypted.
# PROJECT_PATHS accepts one folder per line.
MEETING_CONTEXT=
PROJECT_PATHS=
OBSIDIAN_VAULT_PATH=
MEETING_LANGUAGE=pt-BR

# Optional: where each meeting's audio and transcript folder is written (default: ./meetings).
MEETINGS_DIR=

# Optional: a larger model used only for the final transcript made from the recording.
WHISPER_FINAL_MODEL=

# Optional: another Silero voice-detection model file (default: the one in models/vad).
WHISPER_VAD_MODEL=

# Opcional: sobrescreve as integrações do vault selecionado (somente no processo principal).
# Sem estes valores, reutiliza o MCP/Omnisearch de ~/.codex/config.toml quando
# o obsidian-fs aponta para o mesmo vault e a configuração REST do plugin nesse vault.
HARNESS_MCP_URL=
HARNESS_REST_URL=
HARNESS_API_KEY=
