# Copy this file to .env and add your own key.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Meeting defaults shown in the form and used as a fallback when a field is blank.
# PROJECT_PATHS accepts one folder per line.
MEETING_CONTEXT=
PROJECT_PATHS=
OBSIDIAN_VAULT_PATH=
MEETING_LANGUAGE=pt-BR
MEETING_USE_OLLAMA=false
OPENAI_MODEL=gpt-6-luna
